---
import type { Locale } from "../lib/site";

interface Props { kind: "logo" | "articles" | "socials" | "pptx"; locale?: Locale }
const { kind, locale = "es" } = Astro.props;
const Tag = kind === "logo" ? "h1" : "h2";
const art = {
  logo: String.raw`       ░██
