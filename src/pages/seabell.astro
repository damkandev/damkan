---
import BaseLayout from "../layouts/BaseLayout.astro";
import Tejido from "../components/tejido/Tejido.astro";
import { copy, homePath } from "../lib/site";

export const prerender = true;

// El workflow Release de Seabell sube cada versión con estos nombres fijos.
const release = "https://github.com/damkandev/seabell/releases";
const downloads = [
  { label: "Descargar para Mac", detail: "Apple Silicon e Intel · macOS 11 o superior · .dmg", href: `${release}/latest/download/Seabell-macOS.dmg` },
  { label: "Descargar para Windows", detail: "Windows 10 y 11 · .exe", href: `${release}/latest/download/Seabell-Windows.exe` },
];
---
<BaseLayout locale="es" title="Seabell | Damián Panes" description="Seabell: lector de PDFs para procuradores. Descárgalo para Mac o Windows." theme="tejido">
  <main class="tejido-pagina">
    <Tejido />
    <div class="tejido-columna">
      <a class="tejido-volver" href={homePath("es")}>{copy.es.tejido.back}</a>
      <!-- el ícono como parche cosido, igual que las fotos de los artículos -->
      <div class="icono"><img src="/seabell/icon.png" width="72" height="72" alt="" /></div>
      <h1 class="tejido-titulo">Seabell</h1>
      <p class="tejido-bajada">Lector de PDFs para procuradores. Abre varios documentos lado a lado, resalta, anota y busca en todo el expediente. Funciona sin conexión: tus documentos no salen de tu computador.</p>

      <ul class="descargas">
        {downloads.map(({ label, detail, href }) => (
          <li><a class="tejido-boton" href={href}><span>{label}<small>{detail}</small></span><span aria-hidden="true">&darr;</span></a></li>
        ))}
      </ul>

      <section class="ayuda">
        <h2>La primera vez que la abres</h2>
        <p>Seabell todavía no está firmada por Apple ni Microsoft, así que el sistema te va a pedir confirmación una vez.</p>
        <h3>Mac</h3>
        <ol>
          <li>Abre el <code>.dmg</code> y arrastra Seabell a Aplicaciones.</li>
          <li>Ábrela. Si macOS dice que no puede verificar al desarrollador, ve a Ajustes del Sistema › Privacidad y seguridad y pulsa «Abrir igualmente».</li>
        </ol>
        <h3>Windows</h3>
        <ol>
          <li>Ejecuta el <code>.exe</code>.</li>
          <li>Si aparece «Windows protegió su PC», pulsa «Más información» y luego «Ejecutar de todas formas».</li>
        </ol>
      </section>

      <p class="mas"><a href={release}>Todas las versiones</a> · <a href="https://github.com/damkandev/seabell">Código fuente</a></p>
    </div>
  </main>
</BaseLayout>

<style>
  .icono { width: fit-content; margin: 64px 0 28px; padding: 8px; background: var(--hueso); line-height: 0; transform: rotate(-2deg); box-shadow: 0 14px 30px rgba(0, 0, 0, .45); }
  .icono img { outline: 2px dashed rgba(27, 28, 34, .5); outline-offset: -5px; }
  .descargas { display: grid; gap: 16px; margin: 48px 0 0; padding: 0; list-style: none; }
  .descargas small { display: block; margin-top: 6px; font-family: var(--sans); font-size: 13px; font-weight: 400; color: var(--apagado); }
  /* la ayuda se lee como el cuerpo de un artículo; el h2 lleva las tres puntadas naranjas */
  .ayuda { margin-top: 88px; font-size: 18px; line-height: 1.7; color: var(--texto); }
  .ayuda h2 { margin: 0 0 16px; font-size: 28px; font-weight: 600; line-height: 1.2; color: var(--hueso); }
  .ayuda h2::before { content: ""; display: block; width: 30px; height: 10px; margin-bottom: 18px; background: repeating-linear-gradient(90deg, var(--naranjo) 0 10px, transparent 10px 15px); }
  .ayuda h3 { margin: 32px 0 8px; font-size: 21px; font-weight: 600; color: var(--hueso); }
  .ayuda p, .ayuda ol { margin: 0; }
  .ayuda ol { padding-left: 1.4em; }
  .ayuda li + li { margin-top: 8px; }
  .ayuda li::marker { color: var(--naranjo); }
  .ayuda code { padding: .1em .35em; background: var(--lana-clara); border: 1px dashed rgba(239, 230, 210, .3); font-family: "JetBrains Mono", ui-monospace, monospace; font-size: .82em; color: var(--hueso); }
  .mas { margin: 56px 0 0; font-size: 16px; color: var(--gris); }
  @media (max-width: 600px) {
    .icono { margin-top: 44px; }
    .ayuda { margin-top: 64px; font-size: 17px; }
    .ayuda h2 { font-size: 24px; }
  }
</style>
