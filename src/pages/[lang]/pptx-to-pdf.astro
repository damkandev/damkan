---
import BaseLayout from "../../layouts/BaseLayout.astro";
import AsciiTitle from "../../components/AsciiTitle.astro";
import { MAX_PPTX_BYTES } from "../../lib/pptx-to-pdf";
import { copy, homePath, isLocale, locales, type Locale } from "../../lib/site";

export const prerender = true;

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

if (!isLocale(Astro.params.lang)) return Astro.redirect("/es/", 302);
const locale: Locale = Astro.params.lang;
const c = copy[locale].pptxToPdf;
const seoTitle = `${c.pageTitle} | Damián Panes`;
---
<BaseLayout locale={locale} title={seoTitle} description={c.metaDescription}>
  <main class="tool">
    <a class="article-back" href={homePath(locale)}>{copy[locale].back}</a>
    <AsciiTitle kind="pptx" locale={locale} />
    <p class="intro">{c.intro}</p>

    <div class="section-rule" data-ascii-rule aria-hidden="true"></div>

    <form
      class="converter"
      data-converter
      data-max-bytes={String(MAX_PPTX_BYTES)}
      data-copy={JSON.stringify(c.messages)}
    >
      <div class="converter__field">
        <label class="converter__label" for="pptx-file">{c.chooseLabel}</label>
        <input
          class="converter__input"
          id="pptx-file"
          name="file"
          type="file"
          accept=".pptx,application/vnd.openxmlformats-officedocument.presentationml.presentation"
        />
      </div>

      <div class="converter__settings">
        <div class="converter__setting">
          <label class="converter__setting-label" for="pdf-font">{c.settings.font}</label>
          <select class="converter__select" id="pdf-font" name="font">
            <option value="helvetica">{c.settings.fonts.helvetica}</option>
            <option value="times">{c.settings.fonts.times}</option>
            <option value="courier">{c.settings.fonts.courier}</option>
          </select>
        </div>

        <div class="converter__setting">
          <label class="converter__setting-label" for="pdf-size">{c.settings.size}</label>
          <select class="converter__select" id="pdf-size" name="size">
            <option value="small">{c.settings.sizes.small}</option>
            <option value="medium" selected>{c.settings.sizes.medium}</option>
            <option value="large">{c.settings.sizes.large}</option>
          </select>
        </div>

        <div class="converter__setting">
          <label class="converter__setting-label" for="pdf-alignment">{c.settings.alignment}</label>
          <select class="converter__select" id="pdf-alignment" name="alignment">
            <option value="left">{c.settings.alignments.left}</option>
            <option value="center">{c.settings.alignments.center}</option>
            <option value="right">{c.settings.alignments.right}</option>
            <option value="justify">{c.settings.alignments.justify}</option>
          </select>
        </div>

        <div class="converter__setting">
          <label class="converter__setting-label" for="pdf-orientation">{c.settings.orientation}</label>
          <select class="converter__select" id="pdf-orientation" name="orientation">
            <option value="portrait">{c.settings.orientations.portrait}</option>
            <option value="landscape">{c.settings.orientations.landscape}</option>
          </select>
        </div>
      </div>

      <button class="converter__submit" type="submit" disabled>[ {c.convert} ]</button>
    </form>

    <div class="preview" data-preview hidden>
      <div class="section-rule" data-ascii-rule aria-hidden="true"></div>
      <h2 class="preview__title">{c.preview.title}</h2>
      <div class="preview__summary" data-preview-summary hidden></div>
      <div class="preview__content" data-preview-content></div>
    </div>

    <p class="converter__status" data-converter-status aria-live="polite"></p>
    <a class="converter__download" data-converter-download hidden download>[ {c.messages.download} ]</a>
    <p class="converter__privacy">{c.privacy}</p>
    <p class="converter__dedication">D <3 A</p>
  </main>
</BaseLayout>

<script>
  import { track } from "../../lib/analytics";
  import {
    PptxParseError,
    hasExtractableText,
    parsePptx,
    renderPdf,
    type ParsedPresentation,
    type BlockType,
  } from "../../lib/pptx-to-pdf";

  const form = document.querySelector<HTMLFormElement>("[data-converter]");
  const statusElement = document.querySelector<HTMLElement>("[data-converter-status]");
  const downloadElement = document.querySelector<HTMLAnchorElement>("[data-converter-download]");
  const previewElement = document.querySelector<HTMLElement>("[data-preview]");
  const previewContent = document.querySelector<HTMLElement>("[data-preview-content]");
  const previewSummary = document.querySelector<HTMLElement>("[data-preview-summary]");

  if (form && statusElement && downloadElement && previewElement && previewContent && previewSummary) {
    const input = form.querySelector<HTMLInputElement>("input[type='file']");
    const submit = form.querySelector<HTMLButtonElement>("button[type='submit']");
    const messages: Record<string, string> = JSON.parse(form.dataset.copy ?? "{}");
    const maxBytes = Number(form.dataset.maxBytes ?? "0");
    const message = (key: string) => messages[key] ?? "";

    let busy = false;
    let objectUrl: string | undefined;
    let parsedData: ParsedPresentation | null = null;
    let showAllSlides = false;

    const setStatus = (text: string, kind: "idle" | "info" | "error" | "ok") => {
      statusElement.textContent = text;
      statusElement.dataset.kind = kind;
    };

    const discardResult = () => {
      if (objectUrl) URL.revokeObjectURL(objectUrl);
      objectUrl = undefined;
      downloadElement.hidden = true;
      downloadElement.removeAttribute("href");
    };

    const fail = (text: string) => {
      discardResult();
      setStatus(text, "error");
    };

    const formatSize = (bytes: number) => `${(bytes / 1024 / 1024).toFixed(1)} MB`;

    const renderSlide = (slide: ParsedSlide) => {
      const slideEl = document.createElement("div");
      slideEl.className = "preview__slide";
      slideEl.innerHTML = `<div class="preview__slide-header">${message("slide")} ${slide.slideNumber}</div>`;

      if (slide.title) {
        slideEl.innerHTML += `<div class="preview__block"><span class="preview__block-text" data-type="title">${escapeHtml(slide.title)}</span></div>`;
      }
      if (slide.subtitle) {
        slideEl.innerHTML += `<div class="preview__block"><span class="preview__block-text" data-type="subtitle">${escapeHtml(slide.subtitle)}</span></div>`;
      }

      if (slide.blocks.length === 0 && !slide.title && !slide.subtitle) {
        slideEl.innerHTML += `<div class="preview__empty">${message("empty")}</div>`;
      }

      for (const block of slide.blocks) {
        const blockEl = document.createElement("div");
        blockEl.className = "preview__block";
        blockEl.innerHTML = `
          <select class="preview__block-select" data-block-id="${block.id}">
            <option value="title"${block.type === "title" ? " selected" : ""}>${message("title")}</option>
            <option value="subtitle"${block.type === "subtitle" ? " selected" : ""}>${message("subtitle")}</option>
            <option value="body"${block.type === "body" ? " selected" : ""}>${message("body")}</option>
            <option value="ignored"${block.type === "ignored" ? " selected" : ""}>${message("ignored")}</option>
          </select>
          <span class="preview__block-text" data-block-id="${block.id}" data-type="${block.type}" data-level="${block.level}">${escapeHtml(block.text)}</span>
        `;
        slideEl.appendChild(blockEl);
      }

      return slideEl;
    };

    const renderPreview = (data: ParsedPresentation) => {
      previewContent.innerHTML = "";
      const total = data.slides.length;
      const slidesToShow = showAllSlides
        ? data.slides
        : data.slides.filter((slide) => slide.needsReview);

      for (const slide of slidesToShow) {
        previewContent.appendChild(renderSlide(slide));
      }

      if (slidesToShow.length < total) {
        previewSummary.hidden = false;
        previewSummary.innerHTML = `
          <span>${message("showing").replace("{x}", String(slidesToShow.length)).replace("{y}", String(total))}</span>
          <button type="button" class="preview__toggle" data-action="show-all">[ ${message("showAll")} ]</button>
        `;
      } else if (showAllSlides && total > 0) {
        previewSummary.hidden = false;
        previewSummary.innerHTML = `
          <span>${message("showingAll").replace("{y}", String(total))}</span>
          <button type="button" class="preview__toggle" data-action="show-less">[ ${message("showLess")} ]</button>
        `;
      } else {
        previewSummary.hidden = true;
      }

      previewElement.hidden = false;
    };

    const escapeHtml = (text: string) =>
      text.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");

    previewContent.addEventListener("change", (event) => {
      const target = event.target as HTMLSelectElement;
      if (!target.matches(".preview__block-select")) return;
      const blockId = target.dataset.blockId;
      const newType = target.value as BlockType;
      if (!parsedData || !blockId) return;

      for (const slide of parsedData.slides) {
        for (const block of slide.blocks) {
          if (block.id === blockId) {
            block.type = newType;
            const textEl = previewContent.querySelector<HTMLElement>(`.preview__block-text[data-block-id="${blockId}"]`);
            if (textEl) textEl.dataset.type = newType;
            return;
          }
        }
      }
    });

    previewSummary.addEventListener("click", (event) => {
      const target = event.target as HTMLElement;
      if (!target.matches("[data-action]")) return;
      const action = target.dataset.action;
      if (action === "show-all") {
        showAllSlides = true;
        if (parsedData) renderPreview(parsedData);
      } else if (action === "show-less") {
        showAllSlides = false;
        if (parsedData) renderPreview(parsedData);
      }
    });

    input?.addEventListener("change", async () => {
      const file = input.files?.[0];
      if (submit) submit.disabled = !file;
      discardResult();
      previewElement.hidden = true;
      previewSummary.hidden = true;
      parsedData = null;
      showAllSlides = false;
      if (!file) {
        setStatus("", "idle");
        return;
      }
      setStatus(`${message("selected")} ${file.name} (${formatSize(file.size)})`, "info");

      if (!/\.pptx$/i.test(file.name)) {
        fail(message("notPptx"));
        track("pptx-error", { reason: "notPptx" });
        return;
      }
      if (file.size > maxBytes) {
        fail(message("tooBig"));
        track("pptx-error", { reason: "tooBig" });
        return;
      }

      try {
        setStatus(message("processing"), "info");
        const parsed = await parsePptx(await file.arrayBuffer());
        if (!hasExtractableText(parsed)) throw new PptxParseError("empty");
        parsedData = parsed;
        renderPreview(parsed);
        track("pptx-preview-opened", { slideCount: parsed.slides.length, needsReviewCount: parsed.slides.filter((s) => s.needsReview).length });
        setStatus(`${message("selected")} ${file.name} (${formatSize(file.size)})`, "ok");
      } catch (error: unknown) {
        if (error instanceof PptxParseError) {
          fail(message(error.reason));
          track("pptx-error", { reason: error.reason });
        } else {
          console.error(error);
          fail(message("unexpected"));
          track("pptx-error", { reason: "unexpected" });
        }
      }
    });

    form.addEventListener("submit", (event) => {
      event.preventDefault();
      const file = input?.files?.[0];
      if (!file || busy || !submit || !parsedData) return;

      busy = true;
      submit.disabled = true;
      if (input) input.disabled = true;
      setStatus(message("processing"), "info");

      const finish = () => {
        busy = false;
        submit.disabled = false;
        if (input) input.disabled = false;
      };

      try {
        const pdfName = `${file.name.replace(/\.pptx$/i, "")}.pdf`;
        const fontSelect = form.querySelector<HTMLSelectElement>("[name='font']");
        const sizeSelect = form.querySelector<HTMLSelectElement>("[name='size']");
        const alignmentSelect = form.querySelector<HTMLSelectElement>("[name='alignment']");
        const orientationSelect = form.querySelector<HTMLSelectElement>("[name='orientation']");
        const options = {
          font: (fontSelect?.value as "helvetica" | "times" | "courier") ?? "helvetica",
          size: (sizeSelect?.value as "small" | "medium" | "large") ?? "medium",
          alignment: (alignmentSelect?.value as "left" | "center" | "right" | "justify") ?? "left",
          orientation: (orientationSelect?.value as "portrait" | "landscape") ?? "portrait",
        };
        const blob = renderPdf(parsedData, pdfName, options);
        discardResult();
        objectUrl = URL.createObjectURL(blob);
        downloadElement.href = objectUrl;
        downloadElement.download = pdfName;
        downloadElement.hidden = false;
        downloadElement.click();
        setStatus(`${message("done")} ${pdfName} (${formatSize(blob.size)})`, "ok");
        track("pptx-converted", { fileSize: blob.size, font: options.font, size: options.size, alignment: options.alignment, orientation: options.orientation });
      } catch (error: unknown) {
        console.error(error);
        fail(message("unexpected"));
        track("pptx-error", { reason: "unexpected" });
      } finally {
        finish();
      }
    });

    addEventListener(
      "pagehide",
      () => {
        if (objectUrl) URL.revokeObjectURL(objectUrl);
      },
      { once: true },
    );
  }
</script>
