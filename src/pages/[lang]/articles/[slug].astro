---
// La página de un artículo: el tablero con la reina tumbada y el artículo abierto al lado. El texto va en el HTML, con su
// título, descripción, OG, canónica y hreflang: Google y las vistas previas de links no dependen del JavaScript.
import { getCollection, render, type CollectionEntry } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Tablero from "../../../components/Tablero.astro";
import { articlePath, homePath, isLocale, type Locale } from "../../../lib/site";

export const prerender = true;

export async function getStaticPaths() {
  const entries = await getCollection("articles");
  return entries.map((entry) => ({
    params: { lang: entry.data.locale, slug: entry.data.slug },
    props: { entry, entries },
  }));
}

interface Props {
  entry: CollectionEntry<"articles">;
  entries: CollectionEntry<"articles">[];
}

const { entry, entries } = Astro.props;
const locale: Locale = isLocale(Astro.params.lang) ? Astro.params.lang : "es";
const alternate = entries.find((candidate) =>
  candidate.data.translationKey === entry.data.translationKey && candidate.data.locale !== locale
);
const alternatePath = alternate
  ? articlePath(alternate.data.locale, alternate.data.slug)
  : homePath(locale === "es" ? "en" : "es");
const { Content } = await render(entry);
const seoTitle = `${entry.data.seoTitle ?? entry.data.title} | Damián Panes`;
---
<BaseLayout
  locale={locale}
  title={seoTitle}
  description={entry.data.seoDescription ?? entry.data.excerpt}
  alternatePath={alternatePath}
  ogImage={entry.data.ogImage && entry.data.ogImage !== "/og-default.jpg" ? entry.data.ogImage : `/og/${locale}/${entry.data.slug}.png`}
  pageType="article"
  publishedAt={entry.data.publishedAt}
  theme="tejido"
>
  <Tablero locale={locale} article={{ title: entry.data.title, href: articlePath(locale, entry.data.slug) }}>
    <Content />
  </Tablero>
</BaseLayout>
