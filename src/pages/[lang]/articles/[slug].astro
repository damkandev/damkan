---
import { getCollection, render, type CollectionEntry } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { articlePath, copy, homePath, isLocale, type Locale } from "../../../lib/site";

export async function getStaticPaths() {
  const entries = await getCollection("articles");
  return entries.map((entry) => ({
    params: { lang: entry.data.locale, slug: entry.data.slug },
    props: { entry, entries },
  }));
}

interface Props {
  entry: CollectionEntry<"articles">;
  entries: CollectionEntry<"articles">[];
}

const { entry, entries } = Astro.props;
const locale: Locale = isLocale(Astro.params.lang) ? Astro.params.lang : "es";
const c = copy[locale];
const alternate = entries.find((candidate) =>
  candidate.data.translationKey === entry.data.translationKey && candidate.data.locale !== locale
);
const alternatePath = alternate
  ? articlePath(alternate.data.locale, alternate.data.slug)
  : homePath(locale === "es" ? "en" : "es");
const { Content } = await render(entry);
const date = new Intl.DateTimeFormat(locale === "es" ? "es-CL" : "en-US", { dateStyle: "long" }).format(entry.data.publishedAt);
const seoTitle = `${entry.data.seoTitle ?? entry.data.title} | Damián Panes`;
---
<BaseLayout
  locale={locale}
  title={seoTitle}
  description={entry.data.seoDescription ?? entry.data.excerpt}
  alternatePath={alternatePath}
  ogImage={entry.data.ogImage}
  pageType="article"
  publishedAt={entry.data.publishedAt}
>
  <main class="article">
    <a class="article-back" href={homePath(locale)}>{c.back}</a>
    <header class="article-header">
      <h1>{entry.data.title}</h1>
      <p>{entry.data.excerpt}</p>
      <time class="article-meta" datetime={entry.data.publishedAt.toISOString()}>{date}</time>
    </header>
    <article class="article-body"><Content /></article>
  </main>
</BaseLayout>
