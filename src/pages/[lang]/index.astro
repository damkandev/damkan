---
import { getCollection } from "astro:content";
import AsciiTitle from "../../components/AsciiTitle.astro";
import AsciiTicket from "../../components/AsciiTicket.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import testimonialOne from "../../public/1.png";
import testimonialOneEn from "../../public/1_en.png";
import testimonialTwo from "../../public/2.png";
import testimonialTwoEn from "../../public/2_en.png";
import { articlePath, copy, isLocale, locales, type Locale } from "../../lib/site";

export const prerender = true;

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

if (!isLocale(Astro.params.lang)) return Astro.redirect("/es/", 302);
const locale: Locale = Astro.params.lang;
const c = copy[locale];
const testimonials = locale === "en"
  ? [testimonialOneEn, testimonialTwoEn]
  : [testimonialOne, testimonialTwo];
const articles = (await getCollection("articles"))
  .filter((entry) => entry.data.locale === locale)
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
const articlesPerPage = 3;
const articlePageCount = Math.ceil(articles.length / articlesPerPage);
---
<BaseLayout locale={locale}>
  <section class="hero" aria-labelledby="hero-heading">
    <div class="aizawa" data-aizawa aria-hidden="true"><canvas></canvas></div>
    <div class="hero__content">
      <AsciiTitle kind="logo" locale={locale} />
      <p id="hero-heading" class="intro">{c.bio}</p>
      <p class="hero__prompt">Desliza abajo para leer más...</p>
    </div>
  </section>

  <main class="receipt">
    <section class="testimonials" aria-labelledby="testimonials-heading">
      <div class="testimonials-grid">
        <img src={testimonials[0].src} width={testimonials[0].width} height={testimonials[0].height} alt={locale === "es" ? "Mensaje de Juan Sutil Palma elogiando la página de Damián" : "Message from Juan Sutil Palma praising Damián's website"} />
        <img src={testimonials[1].src} width={testimonials[1].width} height={testimonials[1].height} alt={locale === "es" ? "Conversación con Nacho riéndose de una publicación de Damián" : "Chat with Nacho laughing about one of Damián's posts"} />
      </div>
      <p id="testimonials-heading">{c.testimonials}</p>
    </section>

    <div class="section-rule" data-ascii-rule aria-hidden="true"></div>

    <section class="articles" aria-labelledby="articles-heading">
      <AsciiTitle kind="articles" locale={locale} />
      <p id="articles-heading">{c.articlesIntro}</p>
      <div
        class="ticket-list"
        data-articles-list
        data-page-size={articlesPerPage}
      >
        {articles.map((article, index) => (
          <AsciiTicket
            href={articlePath(locale, article.data.slug)}
            title={article.data.title}
            description={article.data.excerpt}
            cta={c.readMore}
            data-article-index={index}
          />
        ))}
      </div>
      {articlePageCount > 1 && (
        <nav
          class="articles-pagination"
          data-articles-pagination
          data-page-count={articlePageCount}
          aria-label={locale === "es" ? "Paginación de artículos" : "Article pagination"}
        >
          <button type="button" data-page-previous>{c.articlesPagination.previous}</button>
          <span aria-live="polite" aria-atomic="true" data-page-status>
            {c.articlesPagination.page
              .replace("{current}", "1")
              .replace("{total}", String(articlePageCount))}
          </span>
          <button type="button" data-page-next>{c.articlesPagination.next}</button>
        </nav>
      )}
    </section>

    <div class="section-rule" data-ascii-rule aria-hidden="true"></div>

    <section class="socials" aria-labelledby="socials-heading">
      <AsciiTitle kind="socials" locale={locale} />
      <p id="socials-heading">{c.socials}</p>
      <ul>
        <li><a href="https://www.instagram.com/damian.panes/" rel="noopener noreferrer" target="_blank">Instagram</a></li>
        <li><a href="https://www.linkedin.com/in/damianpanes/" rel="noopener noreferrer" target="_blank">LinkedIn</a></li>
        <li><a href="https://github.com/damkandev" rel="noopener noreferrer" target="_blank">GitHub</a></li>
      </ul>
    </section>
  </main>
</BaseLayout>

<script>
  const attractor = document.querySelector<HTMLElement>("[data-aizawa]");
  const canvas = attractor?.querySelector("canvas") ?? null;
  const context = canvas?.getContext("2d") ?? null;
  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
  const layers = 12;
  const thickness = 2;
  const trailLength = 800;
  const offsetX = 0;
  const offsetY = 0;
  const themeDefaults = { opacity: 0.35, weight: 500, size: 9 };

  if (attractor) {
    attractor.style.setProperty("--aizawa-weight", String(themeDefaults.weight));
    attractor.style.setProperty("--aizawa-size", `${themeDefaults.size}px`);
    requestAnimationFrame(() => {
      requestAnimationFrame(() => {
        attractor.style.opacity = "1";
      });
    });
  }

  if (attractor && canvas && context && !reducedMotion.matches) {
    const states = Array.from({ length: 12 }, (_, index) => ({
      x: 0.1 + (index % 4 - 1.5) * 0.025,
      y: (Math.floor(index / 4) - 1) * 0.025,
      z: index * 0.003,
    }));
    const colors = [[218, 255, 166], [216, 232, 174], [214, 207, 185], [220, 178, 205], [255, 152, 236]];
    const chars = " .:+*#";
    // A cell renders a glyph once its intensity reaches the first character
    // bucket; below that it is blank and can be skipped entirely.
    const charThreshold = 1 / chars.length;
    const fadeScale = 5 / trailLength;
    const maxAge = Math.ceil(trailLength / 5) + 1;
    const hoverSteps = 16;
    let lastFrame = 0;
    let frameCounter = 0;

    // Every colour the renderer can produce, built once. Trail-point age is a
    // whole number of frames and faded-out points are never drawn, so the
    // age -> colour gradient covers a small known range of integers; the hover
    // glow is quantised into `hoverSteps` levels. The hot path only indexes
    // these tables, so it never builds a string (the previous version built
    // two per visible character per frame, ~228k short-lived strings a second,
    // which showed up as periodic GC stutter).
    const baseColors: string[] = new Array(maxAge);
    const hoverColors: string[] = new Array(maxAge * hoverSteps);
    for (let age = 0; age < maxAge; age += 1) {
      const progress = Math.min(0.999, (age * fadeScale) / 0.65);
      const position = progress * (colors.length - 1);
      const index = Math.floor(position);
      const amount = position - index;
      const start = colors[index];
      const end = colors[index + 1] ?? start;
      const r = Math.round(start[0] + (end[0] - start[0]) * amount);
      const g = Math.round(start[1] + (end[1] - start[1]) * amount);
      const b = Math.round(start[2] + (end[2] - start[2]) * amount);
      baseColors[age] = `rgba(${r},${g},${b},${themeDefaults.opacity})`;
      for (let step = 0; step < hoverSteps; step += 1) {
        const boost = step / (hoverSteps - 1);
        const alpha = themeDefaults.opacity + (1 - themeDefaults.opacity) * boost;
        hoverColors[age * hoverSteps + step] = `rgba(${r},${g},${b},${alpha.toFixed(3)})`;
      }
    }

    // Aizawa's z ranges roughly 0-2 (not zero-centered), so recenter before
    // rotating or the whole shape swings off-axis instead of spinning in place.
    const zCenter = 1;
    const autoRotationSpeed = (Math.PI * 2) / (60 * 30); // ~one revolution per 60s at ~30fps draw ticks
    let autoAngle = 0;

    const pointerTiltMax = 0.32;
    let pointerTiltTargetX = 0;
    let pointerTiltTargetY = 0;
    let pointerTiltX = 0;
    let pointerTiltY = 0;
    const hoverRadius = 70;
    const hoverRadiusSquared = hoverRadius * hoverRadius;
    const parallaxFactor = 0.15;
    // Where supported the parallax is a scroll-linked CSS animation running on
    // the compositor, so JS must not fight it by writing `transform` itself.
    const compositedParallax = CSS.supports("animation-timeline", "scroll()");
    let hasPointer = false;
    let pointerClientX = 0;
    let pointerClientY = 0;
    window.addEventListener("pointermove", (event) => {
      pointerTiltTargetY = ((event.clientX / window.innerWidth) * 2 - 1) * pointerTiltMax;
      pointerTiltTargetX = ((event.clientY / window.innerHeight) * 2 - 1) * pointerTiltMax;
      pointerClientX = event.clientX;
      pointerClientY = event.clientY;
      hasPointer = true;
    }, { passive: true });

    // The thickness=2 stamp falloff is identical for every trail point every
    // frame, so precompute it once instead of calling Math.hypot per cell
    // per point (up to ~240k sqrt calls/frame otherwise).
    const stampX: number[] = [];
    const stampY: number[] = [];
    const stampW: number[] = [];
    for (let sy = -thickness; sy <= thickness; sy += 1) {
      for (let sx = -thickness; sx <= thickness; sx += 1) {
        const distance = Math.hypot(sx, sy);
        if (distance > thickness) continue;
        stampX.push(sx);
        stampY.push(sy);
        stampW.push(1 - distance / (thickness + 1));
      }
    }
    const stampCount = stampX.length;
    const stampOffsetX = Int32Array.from(stampX);
    const stampOffsetY = Int32Array.from(stampY);
    const stampWeight = Float32Array.from(stampW);

    // Ring buffer for trail points: fixed-size typed arrays instead of an
    // array of objects, so advancing the trail allocates nothing per frame
    // and dropping old points is an O(1) overwrite instead of an O(n) splice.
    // Points record the frame they were born on rather than an age that has to
    // be incremented across the whole buffer every frame.
    const trailCapacity = layers * trailLength;
    const trailX = new Float32Array(trailCapacity);
    const trailY = new Float32Array(trailCapacity);
    const trailZ = new Float32Array(trailCapacity);
    const trailBirth = new Int32Array(trailCapacity);
    let trailWriteIndex = 0;
    let trailFilled = 0;

    // Layout metrics only change on resize/font-load, not every frame, so they're
    // measured outside draw(). Reading layout (getBoundingClientRect, clientWidth,
    // getComputedStyle) every frame right after writing `transform` forces a
    // synchronous layout flush ~30x/sec, which is a major source of jank.
    let characterWidth = themeDefaults.size * 0.6;
    let lineHeight = themeDefaults.size * 1.32;
    let width = 32;
    let height = 24;
    let baseRectTop = 0;
    let baseRectLeft = 0;
    let cssWidth = 0;
    let cssHeight = 0;

    // Reused per-cell buffers, only reallocated in measure() when the grid
    // size actually changes (not every frame).
    let intensity = new Float32Array(width * height);
    let ages = new Int32Array(width * height);
    let centerClaim = new Int32Array(width * height);
    let scratchCells = new Int32Array(width * height);
    let sortedCells = new Int32Array(width * height);
    const bucketCounts = new Int32Array(maxAge);
    const bucketCursor = new Int32Array(maxAge);

    const measure = () => {
      const rootStyles = getComputedStyle(attractor);
      const fontSize = parseFloat(rootStyles.getPropertyValue("--aizawa-size")) || themeDefaults.size;
      const fontWeight = rootStyles.getPropertyValue("--aizawa-weight").trim() || String(themeDefaults.weight);

      cssWidth = attractor.clientWidth;
      cssHeight = attractor.clientHeight;
      // Assigning width/height resets every context property, so the font,
      // baseline and DPR transform have to be (re)applied right here.
      const ratio = Math.min(window.devicePixelRatio || 1, 2);
      canvas.width = Math.round(cssWidth * ratio);
      canvas.height = Math.round(cssHeight * ratio);
      context.setTransform(ratio, 0, 0, ratio, 0, 0);
      context.font = `${fontWeight} ${fontSize}px "JetBrains Mono", monospace`;
      context.textBaseline = "top";

      characterWidth = context.measureText("0").width || fontSize * 0.6;
      lineHeight = fontSize * 1.32;
      const nextWidth = Math.max(32, Math.floor(cssWidth / characterWidth));
      const nextHeight = Math.max(24, Math.floor(cssHeight / lineHeight));
      if (nextWidth !== width || nextHeight !== height) {
        width = nextWidth;
        height = nextHeight;
        const cells = width * height;
        intensity = new Float32Array(cells);
        ages = new Int32Array(cells);
        centerClaim = new Int32Array(cells);
        scratchCells = new Int32Array(cells);
        sortedCells = new Int32Array(cells);
      }
      const previousTransform = attractor.style.transform;
      attractor.style.transform = "";
      const rect = attractor.getBoundingClientRect();
      baseRectTop = rect.top + window.scrollY;
      baseRectLeft = rect.left;
      attractor.style.transform = previousTransform;
    };

    // The CSS animation maps the whole scroll range onto a translation, so it
    // needs the total distance in pixels. Page height changes rarely (fonts,
    // resize, paginating the article list), so it's recomputed on those rather
    // than per frame.
    const updateParallaxDistance = () => {
      const maxScroll = Math.max(0, document.documentElement.scrollHeight - window.innerHeight);
      attractor.style.setProperty("--aizawa-parallax-distance", `${maxScroll * parallaxFactor}px`);
    };

    measure();
    updateParallaxDistance();
    document.fonts?.ready?.then(() => {
      measure();
      updateParallaxDistance();
    });
    window.addEventListener("resize", () => {
      measure();
      updateParallaxDistance();
    }, { passive: true });
    new ResizeObserver(updateParallaxDistance).observe(document.body);

    const draw = (time: number) => {
      if (!onScreen) {
        looping = false;
        return;
      }
      const scrollY = window.scrollY;
      const parallaxOffset = scrollY * parallaxFactor;
      if (!compositedParallax) {
        // Fallback path: update the parallax every animation frame rather than
        // on the throttled simulation tick, so a fast scroll doesn't step.
        attractor.style.transform = `translateY(${parallaxOffset}px)`;
      }
      if (time - lastFrame < 33) {
        requestAnimationFrame(draw);
        return;
      }
      lastFrame = time;
      // `ages` deliberately isn't cleared: it is only ever read for cells that
      // won an intensity write this frame, which always writes both.
      intensity.fill(0);

      for (let step = 0; step < 5; step += 1) {
        for (let layer = 0; layer < layers; layer += 1) {
          const state = states[layer];
          const dx = (state.z - 0.7) * state.x - 3.5 * state.y;
          const dy = 3.5 * state.x + (state.z - 0.7) * state.y;
          const dz = 0.6 + 0.95 * state.z - state.z ** 3 / 3 - (state.x ** 2 + state.y ** 2) * (1 + 0.25 * state.z) + 0.1 * state.z * state.x ** 3;
          state.x += dx * 0.01;
          state.y += dy * 0.01;
          state.z += dz * 0.01;
          trailX[trailWriteIndex] = state.x;
          trailY[trailWriteIndex] = state.y;
          trailZ[trailWriteIndex] = state.z;
          trailBirth[trailWriteIndex] = frameCounter;
          trailWriteIndex = (trailWriteIndex + 1) % trailCapacity;
          if (trailFilled < trailCapacity) trailFilled += 1;
        }
      }
      frameCounter += 1;

      autoAngle += autoRotationSpeed;
      pointerTiltX += (pointerTiltTargetX - pointerTiltX) * 0.06;
      pointerTiltY += (pointerTiltTargetY - pointerTiltY) * 0.06;
      const scrollProgress = Math.min(1, Math.max(0, scrollY / window.innerHeight));
      const yaw = autoAngle + pointerTiltY + scrollProgress * 1;
      const pitch = pointerTiltX;
      const cosYaw = Math.cos(yaw);
      const sinYaw = Math.sin(yaw);
      const cosPitch = Math.cos(pitch);
      const sinPitch = Math.sin(pitch);
      const currentRectTop = baseRectTop - scrollY + parallaxOffset;
      const pointerColumn = (pointerClientX - baseRectLeft) / characterWidth;
      const pointerRow = (pointerClientY - currentRectTop) / lineHeight;

      // Walk the ring buffer newest -> oldest so `fade` is non-increasing.
      // That makes two things exact rather than heuristic: the loop can stop at
      // the first faded-out point, and any point whose centre cell was already
      // claimed this frame can be skipped outright -- the earlier (newer) point
      // stamped the same offsets with the same weights at a higher-or-equal
      // fade, and intensity only updates on a strictly greater value, so the
      // skipped point could not have changed either buffer.
      let cursor = trailWriteIndex - 1;
      if (cursor < 0) cursor = trailCapacity - 1;
      for (let n = 0; n < trailFilled; n += 1) {
        const i = cursor;
        cursor = cursor === 0 ? trailCapacity - 1 : cursor - 1;
        const age = frameCounter - trailBirth[i];
        const fade = 1 - age * fadeScale;
        if (fade <= 0) break;
        const centeredZ = trailZ[i] - zCenter;
        const pointX = trailX[i];
        const rotatedX = pointX * cosYaw + centeredZ * sinYaw;
        const rotatedDepth = -pointX * sinYaw + centeredZ * cosYaw;
        const rotatedY = trailY[i] * cosPitch - rotatedDepth * sinPitch;
        const centerX = Math.round(width / 2 + rotatedX / 2.35 * width + offsetX / 100 * width);
        const centerY = Math.round(height / 2 - rotatedY / 2.35 * height + offsetY / 100 * height);
        if (centerX >= 0 && centerX < width && centerY >= 0 && centerY < height) {
          const centerIndex = centerY * width + centerX;
          if (centerClaim[centerIndex] === frameCounter) continue;
          centerClaim[centerIndex] = frameCounter;
        }
        for (let k = 0; k < stampCount; k += 1) {
          const column = centerX + stampOffsetX[k];
          const row = centerY + stampOffsetY[k];
          if (column < 0 || column >= width || row < 0 || row >= height) continue;
          const index = row * width + column;
          const value = fade * stampWeight[k];
          if (value > intensity[index]) {
            intensity[index] = value;
            ages[index] = age < maxAge ? age : maxAge - 1;
          }
        }
      }

      // Only cells within hoverRadius of the cursor can have a non-zero glow,
      // so the falloff is evaluated over that box alone instead of the whole
      // grid, and those cells are drawn in their own pass below.
      let hoverColumnMin = 0;
      let hoverColumnMax = -1;
      let hoverRowMin = 0;
      let hoverRowMax = -1;
      if (hasPointer) {
        const columnRadius = Math.ceil(hoverRadius / characterWidth);
        const rowRadius = Math.ceil(hoverRadius / lineHeight);
        const column = Math.round(pointerColumn);
        const row = Math.round(pointerRow);
        hoverColumnMin = Math.max(0, column - columnRadius);
        hoverColumnMax = Math.min(width - 1, column + columnRadius);
        hoverRowMin = Math.max(0, row - rowRadius);
        hoverRowMax = Math.min(height - 1, row + rowRadius);
      }

      // Counting-sort the plain (non-hover) visible cells by age so the canvas
      // needs one fillStyle change per distinct colour rather than per cell.
      bucketCounts.fill(0);
      let visibleCount = 0;
      for (let row = 0; row < height; row += 1) {
        const rowOffset = row * width;
        const rowInHover = row >= hoverRowMin && row <= hoverRowMax;
        for (let column = 0; column < width; column += 1) {
          const index = rowOffset + column;
          if (intensity[index] < charThreshold) continue;
          if (rowInHover && column >= hoverColumnMin && column <= hoverColumnMax) continue;
          scratchCells[visibleCount] = index;
          visibleCount += 1;
          bucketCounts[ages[index]] += 1;
        }
      }
      let running = 0;
      for (let bucket = 0; bucket < maxAge; bucket += 1) {
        bucketCursor[bucket] = running;
        running += bucketCounts[bucket];
      }
      for (let n = 0; n < visibleCount; n += 1) {
        const index = scratchCells[n];
        const slot = bucketCursor[ages[index]];
        bucketCursor[ages[index]] = slot + 1;
        sortedCells[slot] = index;
      }

      context.clearRect(0, 0, cssWidth, cssHeight);
      let drawn = 0;
      for (let bucket = 0; bucket < maxAge; bucket += 1) {
        const count = bucketCounts[bucket];
        if (count === 0) continue;
        context.fillStyle = baseColors[bucket];
        const end = drawn + count;
        for (let n = drawn; n < end; n += 1) {
          const index = sortedCells[n];
          const row = (index / width) | 0;
          const column = index - row * width;
          const charIndex = Math.min(chars.length - 1, (intensity[index] * chars.length) | 0);
          context.fillText(chars[charIndex], column * characterWidth, row * lineHeight);
        }
        drawn = end;
      }

      for (let row = hoverRowMin; row <= hoverRowMax; row += 1) {
        const rowOffset = row * width;
        const dyPixels = (row - pointerRow) * lineHeight;
        const dySquared = dyPixels * dyPixels;
        for (let column = hoverColumnMin; column <= hoverColumnMax; column += 1) {
          const index = rowOffset + column;
          const value = intensity[index];
          if (value < charThreshold) continue;
          const dxPixels = (column - pointerColumn) * characterWidth;
          const distanceSquared = dxPixels * dxPixels + dySquared;
          const boost = distanceSquared < hoverRadiusSquared
            ? (1 - distanceSquared / hoverRadiusSquared) ** 2
            : 0;
          const step = (boost * (hoverSteps - 1) + 0.5) | 0;
          context.fillStyle = hoverColors[ages[index] * hoverSteps + step];
          const charIndex = Math.min(chars.length - 1, (value * chars.length) | 0);
          context.fillText(chars[charIndex], column * characterWidth, row * lineHeight);
        }
      }

      requestAnimationFrame(draw);
    };

    // Rendering a background nobody can see is pure waste, so the loop stops
    // once the hero scrolls away and restarts just before it comes back.
    let onScreen = true;
    let looping = false;
    const startLoop = () => {
      if (looping) return;
      looping = true;
      lastFrame = 0;
      requestAnimationFrame(draw);
    };

    new IntersectionObserver((entries) => {
      onScreen = entries[entries.length - 1].isIntersecting;
      if (onScreen) startLoop();
    }, { rootMargin: "200px" }).observe(attractor);

    startLoop();
  }

  const list = document.querySelector<HTMLElement>("[data-articles-list]");
  const pagination = document.querySelector<HTMLElement>("[data-articles-pagination]");

  if (list && pagination) {
    const articles = [...list.querySelectorAll<HTMLElement>("[data-article-index]")];
    const previous = pagination.querySelector<HTMLButtonElement>("[data-page-previous]");
    const next = pagination.querySelector<HTMLButtonElement>("[data-page-next]");
    const status = pagination.querySelector<HTMLElement>("[data-page-status]");
    const pageSize = Number(list.dataset.pageSize);
    const pageCount = Number(pagination.dataset.pageCount);
    const statusTemplate = status?.textContent?.trim() ?? "";

    const pageFromUrl = () => {
      const requestedPage = Number(new URLSearchParams(window.location.search).get("articles"));
      return Number.isInteger(requestedPage) && requestedPage >= 1 && requestedPage <= pageCount
        ? requestedPage
        : 1;
    };

    let currentPage = pageFromUrl();

    const showPage = (page: number, updateHistory = false) => {
      currentPage = Math.min(pageCount, Math.max(1, page));
      const firstArticle = (currentPage - 1) * pageSize;
      const lastArticle = firstArticle + pageSize;

      articles.forEach((article, index) => {
        article.hidden = index < firstArticle || index >= lastArticle;
      });

      if (previous) previous.disabled = currentPage === 1;
      if (next) next.disabled = currentPage === pageCount;
      if (status) {
        status.textContent = statusTemplate
          .replace("1", String(currentPage))
          .replace(String(pageCount), String(pageCount));
      }

      if (updateHistory) {
        const url = new URL(window.location.href);
        if (currentPage === 1) url.searchParams.delete("articles");
        else url.searchParams.set("articles", String(currentPage));
        window.history.pushState({ articlesPage: currentPage }, "", url);
      }
    };

    previous?.addEventListener("click", () => showPage(currentPage - 1, true));
    next?.addEventListener("click", () => showPage(currentPage + 1, true));
    window.addEventListener("popstate", () => showPage(pageFromUrl()));
    showPage(currentPage);
  }
</script>
