---
// Home: el tablero en dither. Cada pieza es una sección del sitio (ver components/Tablero.astro).
import BaseLayout from "../../layouts/BaseLayout.astro";
import Tablero from "../../components/Tablero.astro";
import { isLocale, locales, type Locale } from "../../lib/site";

export const prerender = true;

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

if (!isLocale(Astro.params.lang)) return Astro.redirect("/es/", 302);
const locale: Locale = Astro.params.lang;
---
<BaseLayout locale={locale} theme="tejido">
  <Tablero locale={locale} />
</BaseLayout>
