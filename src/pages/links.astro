---
import BaseLayout from "../layouts/BaseLayout.astro";
import Tejido from "../components/tejido/Tejido.astro";
import { copy, homePath } from "../lib/site";

export const prerender = true;

// Edit this list to add or remove links.
const links = [
  { label: "Mi empresa de desarrollo", href: "https://kerokero.cl" },
  { label: "Mi startup de autos", href: "https://rodar.cl" },
  { label: "Mi página personal", href: "https://dapan.es" },
  { label: "Mi Instagram", href: "https://instagram.com/damian.panes" },
];
---
<BaseLayout locale="es" title="Links | Damián Panes" description="Links de Damián Panes." theme="tejido">
  <main class="tejido-pagina">
    <Tejido />
    <div class="tejido-columna">
      <a class="tejido-volver" href={homePath("es")}>{copy.es.tejido.back}</a>
      <h1 class="tejido-titulo">Links</h1>
      <ul>
        {links.map(({ label, href }) => (
          <li><a class="tejido-boton" href={href} target="_blank" rel="noopener noreferrer"><span>{label}</span><span aria-hidden="true">&rarr;</span></a></li>
        ))}
      </ul>
    </div>
  </main>
</BaseLayout>

<style>
  h1 { margin-top: 72px; }
  ul { display: grid; gap: 16px; margin: 40px 0 0; padding: 0; list-style: none; }
  @media (max-width: 600px) { h1 { margin-top: 48px; } }
</style>
