---
import "@fontsource/jetbrains-mono/400.css";
import "@fontsource/jetbrains-mono/700.css";
import "../styles/global.css";
import faviconUrl from "../public/icono.svg?url";
import SiteChrome from "../components/SiteChrome.astro";
import type { Locale } from "../lib/site";
import { copy, homePath } from "../lib/site";

interface Props {
  locale: Locale;
  title?: string;
  description?: string;
  alternatePath?: string;
  ogImage?: string;
  pageType?: "website" | "article";
  publishedAt?: Date;
  noindex?: boolean;
}

const {
  locale,
  title = copy[locale].title,
  description = copy[locale].description,
  alternatePath,
  ogImage = "/og-default.jpg",
  pageType = "website",
  publishedAt,
  noindex = false,
} = Astro.props;
const otherLocale: Locale = locale === "es" ? "en" : "es";
const otherPath = alternatePath ?? homePath(otherLocale);
// `Astro.site` can be temporarily undefined while the dev server reloads its
// config. Keep production SEO URLs stable instead of passing an invalid base
// to the URL constructor.
const siteUrl = Astro.site ?? new URL("https://dapan.es");
const canonicalUrl = new URL(Astro.url.pathname, siteUrl);
const alternateUrls: Record<Locale, URL> = {
  [locale]: canonicalUrl,
  [otherLocale]: new URL(otherPath, siteUrl),
} as Record<Locale, URL>;
const ogImageUrl = new URL(ogImage, siteUrl);
const ogLocale = locale === "es" ? "es_CL" : "en_US";
const alternateOgLocale = otherLocale === "es" ? "es_CL" : "en_US";
const structuredData = noindex
  ? null
  : pageType === "article"
  ? {
      "@context": "https://schema.org",
      "@type": "BlogPosting",
      headline: title.replace(/ \| Damián Panes$/, ""),
      description,
      image: ogImageUrl.href,
      datePublished: publishedAt?.toISOString(),
      inLanguage: locale,
      mainEntityOfPage: canonicalUrl.href,
      author: {
        "@type": "Person",
        name: "Damián Panes",
        url: new URL(homePath(locale), siteUrl).href,
      },
      publisher: {
        "@type": "Person",
        name: "Damián Panes",
        url: new URL(homePath(locale), siteUrl).href,
      },
    }
  : {
      "@context": "https://schema.org",
      "@type": "ProfilePage",
      name: title,
      description,
      url: canonicalUrl.href,
      inLanguage: locale,
      mainEntity: {
        "@type": "Person",
        name: "Damián Panes",
        url: canonicalUrl.href,
        sameAs: [
          "https://www.instagram.com/damian.panes/",
          "https://www.linkedin.com/in/damianpanes/",
          "https://github.com/damkandev",
        ],
      },
    };
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? "noindex,follow" : "index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1"} />
    <title>{title}</title>
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="es" href={alternateUrls.es} />
    <link rel="alternate" hreflang="en" href={alternateUrls.en} />
    <link rel="alternate" hreflang="x-default" href={alternateUrls.es} />
    <link rel="icon" type="image/svg+xml" href={faviconUrl} />
    <meta property="og:type" content={pageType} />
    <meta property="og:site_name" content="dapan.es" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={locale === "es" ? "dapan.es, sitio personal de Damián Panes" : "dapan.es, Damián Panes' personal website"} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:locale:alternate" content={alternateOgLocale} />
    {publishedAt && <meta property="article:published_time" content={publishedAt.toISOString()} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={locale === "es" ? "dapan.es, sitio personal de Damián Panes" : "dapan.es, Damián Panes' personal website"} />
    {structuredData && <script type="application/ld+json" set:html={JSON.stringify(structuredData)}></script>}
    <script is:inline>
      (() => {
        const stored = localStorage.getItem("theme");
        const theme = stored === "light" || stored === "dark"
          ? stored
          : matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
        document.documentElement.dataset.theme = theme;
        if (!matchMedia("(prefers-reduced-motion: reduce)").matches) {
          document.documentElement.setAttribute("data-printing", "true");
          setTimeout(() => document.documentElement.removeAttribute("data-printing"), 5000);
        }
      })();
    </script>
  </head>
  <body>
    <div class="page-shell">
      <div id="paper-texture" aria-hidden="true"></div>
      <div class="page-content">
        <SiteChrome locale={locale} alternatePath={alternatePath} />
        <slot />
        <footer class="receipt-footer" data-ascii-rule aria-hidden="true"></footer>
      </div>
    </div>
    <script>
      import {
        ShaderFitOptions,
        ShaderMount,
        getShaderColorFromString,
        getShaderNoiseTexture,
        paperTextureFragmentShader,
      } from "@paper-design/shaders";

      const host = document.querySelector<HTMLElement>("#paper-texture");
      let shader: ShaderMount | undefined;
      const palette = () => document.documentElement.dataset.theme === "dark"
        ? { front: "#25231f", back: "#171612" }
        : { front: "#ebe4d7", back: "#fffdf8" };
      const colors = () => ({
        u_colorFront: getShaderColorFromString(palette().front),
        u_colorBack: getShaderColorFromString(palette().back),
      });

      if (host) {
        try {
          shader = new ShaderMount(host, paperTextureFragmentShader, {
            u_image: undefined,
            u_noiseTexture: getShaderNoiseTexture(),
            ...colors(),
            u_contrast: 0.18,
            u_roughness: 0.48,
            u_fiber: 0.24,
            u_fiberSize: 0.18,
            u_crumples: 0.22,
            u_crumpleSize: 0.42,
            u_foldCount: 4,
            u_folds: 0.22,
            u_fade: 0.12,
            u_drops: 0.08,
            u_seed: 8.13,
            u_fit: ShaderFitOptions.cover,
            u_scale: 0.75,
            u_rotation: 0,
            u_offsetX: 0,
            u_offsetY: 0,
            u_originX: 0.5,
            u_originY: 0.5,
            u_worldWidth: 0,
            u_worldHeight: 0,
          }, undefined, 0, 0, 1, 2073600);
        } catch {
          host.dataset.failed = "true";
        }
      }

      document.querySelectorAll<HTMLButtonElement>("[data-set-theme]").forEach((button) => {
        const syncPressedState = () => {
          button.setAttribute("aria-pressed", String(button.dataset.setTheme === document.documentElement.dataset.theme));
        };
        syncPressedState();
        button.addEventListener("click", () => {
          const theme = button.dataset.setTheme;
          if (theme !== "light" && theme !== "dark") return;
          document.documentElement.dataset.theme = theme;
          localStorage.setItem("theme", theme);
          shader?.setUniforms(colors());
          document.querySelectorAll<HTMLButtonElement>("[data-set-theme]").forEach((candidate) => {
            candidate.setAttribute("aria-pressed", String(candidate.dataset.setTheme === theme));
          });
        });
      });

      const measureCharacter = (element: HTMLElement) => {
        const probe = document.createElement("span");
        probe.className = "character-probe";
        probe.textContent = "0".repeat(100);
        element.append(probe);
        const width = probe.getBoundingClientRect().width / 100;
        probe.remove();
        return width;
      };

      const columnCount = (element: HTMLElement, minimum = 24) => {
        const characterWidth = measureCharacter(element);
        return Math.max(minimum, Math.floor(element.clientWidth / characterWidth));
      };

      const renderTicket = (ticket: HTMLElement) => {
        const box = ticket.querySelector<HTMLElement>(".ascii-ticket__box");
        const content = ticket.querySelector<HTMLElement>(".ascii-ticket__content");
        const edges = ticket.querySelectorAll<HTMLElement>(".ascii-ticket__edge");
        const rails = ticket.querySelectorAll<HTMLElement>(".ascii-ticket__rail");
        if (!box || !content || edges.length !== 2 || rails.length !== 2) return;

        const characterWidth = measureCharacter(ticket);
        const columns = Math.max(24, Math.floor(ticket.clientWidth / characterWidth));
        const snappedWidth = columns * characterWidth;
        const border = `|${"-".repeat(columns - 2)}|`;
        box.style.width = `${snappedWidth}px`;
        edges.forEach((edge) => { edge.textContent = border; });

        const lineHeight = Number.parseFloat(getComputedStyle(content).lineHeight);
        const rowCount = Math.max(1, Math.ceil(content.getBoundingClientRect().height / lineHeight));
        const rail = Array.from({ length: rowCount }, () => "|").join("\n");
        rails.forEach((side) => { side.textContent = rail; });
      };

      const renderRule = (rule: HTMLElement) => {
        rule.textContent = "-".repeat(columnCount(rule, 8));
      };

      const responsiveAscii = [
        ...document.querySelectorAll<HTMLElement>("[data-ascii-ticket]"),
        ...document.querySelectorAll<HTMLElement>("[data-ascii-rule]"),
      ];
      const renderAscii = (element: HTMLElement) => {
        if (element.matches("[data-ascii-ticket]")) renderTicket(element);
        else renderRule(element);
      };
      const asciiObserver = new ResizeObserver((entries) => {
        entries.forEach(({ target }) => renderAscii(target as HTMLElement));
      });
      responsiveAscii.forEach((element) => {
        renderAscii(element);
        asciiObserver.observe(element);
      });

      const printPage = (content: HTMLElement) => {
        const finishPrinting = () => {
          content.style.clipPath = "";
          document.documentElement.removeAttribute("data-printing");
        };
        const lineHeight = Number.parseFloat(getComputedStyle(content).lineHeight) || 21;
        let printed = 0;
        const tick = () => {
          const lines = Math.max(1, Math.ceil(content.scrollHeight / lineHeight));
          const rowsPerTick = Math.max(1, Math.round(lines / 35));
          printed = Math.min(lines, printed + rowsPerTick);
          content.style.clipPath = `inset(0 0 calc(100% - ${printed * lineHeight}px) 0)`;
          if (printed >= lines) {
            finishPrinting();
            return;
          }
          const delay = (2600 / (lines / rowsPerTick)) * (0.5 + Math.random());
          const hiccup = Math.random() < 0.12 ? 80 + Math.random() * 140 : 0;
          setTimeout(tick, delay + hiccup);
        };
        tick();
      };

      const printedContent = document.querySelector<HTMLElement>(".page-shell");
      if (printedContent && document.documentElement.hasAttribute("data-printing")) {
        if (matchMedia("(prefers-reduced-motion: reduce)").matches) {
          document.documentElement.removeAttribute("data-printing");
        } else {
          printPage(printedContent);
        }
      }

      addEventListener("pagehide", () => {
        shader?.dispose();
        asciiObserver.disconnect();
      }, { once: true });
    </script>
  </body>
</html>
